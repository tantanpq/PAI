{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pai:wflow:loop-blueprint:r1",
  "title": "PAI W_Flow Loop Blueprint R1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "loop_id", "goal_value", "signal_inputs",
    "mission_selection", "ownership", "cycle_budget", "produce_build_contract",
    "self_test", "independent_qa", "canary_distribution", "metrics", "learning",
    "next_cycle", "stop_semantics", "state", "lifecycle", "authority_gates"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "loop_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "goal_value": {
      "type": "object", "additionalProperties": false,
      "required": ["goal", "value_hypothesis", "success_evidence"],
      "properties": {
        "goal": {"type": "string", "minLength": 1},
        "value_hypothesis": {"type": "string", "minLength": 1},
        "success_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "signal_inputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/input"}},
    "mission_selection": {
      "type": "object", "additionalProperties": false,
      "required": ["policy", "eligibility", "dedup_key"],
      "properties": {
        "policy": {"type": "string", "minLength": 1},
        "eligibility": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "dedup_key": {"type": "string", "minLength": 1}
      }
    },
    "ownership": {
      "type": "object", "additionalProperties": false, "required": ["owner", "mutable_scope"],
      "properties": {"owner": {"type": "string", "minLength": 1}, "mutable_scope": {"type": "string", "minLength": 1}}
    },
    "cycle_budget": {
      "type": "object", "additionalProperties": false, "required": ["max_work_items", "max_attempts"],
      "properties": {"max_work_items": {"type": "integer", "minimum": 1}, "max_attempts": {"type": "integer", "minimum": 1}}
    },
    "produce_build_contract": {"$ref": "#/$defs/checkContract"},
    "self_test": {"$ref": "#/$defs/checkContract"},
    "independent_qa": {"allOf": [{"$ref": "#/$defs/checkContract"}, {"type": "object", "required": ["independent_owner"], "properties": {"independent_owner": {"type": "string", "minLength": 1}}}]},
    "canary_distribution": {
      "type": "object", "additionalProperties": false, "required": ["mode", "acceptance", "live_effect"],
      "properties": {
        "mode": {"enum": ["NONE", "LOCAL_CANARY", "BOUNDED_DISTRIBUTION"]},
        "acceptance": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "live_effect": {"const": "NONE"}
      }
    },
    "metrics": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/metric"}},
    "learning": {
      "type": "object", "additionalProperties": false,
      "required": ["lesson_candidates", "negative_knowledge", "evaluation_delta", "regression_delta", "reuse_candidates", "promotion"],
      "properties": {
        "lesson_candidates": {"type": "array", "items": {"type": "string"}},
        "negative_knowledge": {"type": "array", "items": {"type": "string"}},
        "evaluation_delta": {"type": "string"}, "regression_delta": {"type": "string"},
        "reuse_candidates": {"type": "array", "items": {"type": "string"}},
        "promotion": {"const": "CANDIDATE_ONLY"}
      }
    },
    "next_cycle": {
      "type": "object", "additionalProperties": false, "required": ["requires_new_observation", "requires_material_delta", "maturity_rule"],
      "properties": {
        "requires_new_observation": {"type": "boolean"}, "requires_material_delta": {"type": "boolean"},
        "maturity_rule": {"type": "string", "minLength": 1}
      }
    },
    "stop_semantics": {
      "type": "object", "additionalProperties": false, "required": ["no_material_delta", "local_blocker", "authority_required", "retire"],
      "properties": {
        "no_material_delta": {"const": "WAIT_SIGNAL"}, "local_blocker": {"const": "BLOCKED_LOCAL"},
        "authority_required": {"const": "AUTHORITY_GATE"}, "retire": {"const": "RETIRED"}
      }
    },
    "state": {"enum": ["SEED", "FOUNDATION", "ACTIVE_CANARY", "ACTIVE", "WAIT_SIGNAL", "BLOCKED_LOCAL", "AUTHORITY_GATE", "PAUSED", "RETIRED"]},
    "lifecycle": {"enum": ["CANDIDATE", "DONE", "LIVE"]},
    "authority_gates": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["PUBLIC", "MONEY", "LEGAL", "CREDENTIAL", "TRUST_ROOT", "DESTRUCTIVE", "PRODUCTION_AUTHORITY"]}
    }
  },
  "$defs": {
    "input": {"type": "object", "additionalProperties": false, "required": ["name", "source", "observation_digest"], "properties": {"name": {"type": "string", "minLength": 1}, "source": {"type": "string", "minLength": 1}, "observation_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "checkContract": {"type": "object", "additionalProperties": false, "required": ["inputs", "outputs", "acceptance"], "properties": {"inputs": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "outputs": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "acceptance": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "independent_owner": {"type": "string"}}},
    "metric": {"type": "object", "additionalProperties": false, "required": ["name", "measure", "target"], "properties": {"name": {"type": "string", "minLength": 1}, "measure": {"type": "string", "minLength": 1}, "target": {"type": "string", "minLength": 1}}}
  }
}
